{
  "version": "0.1.0",
  "name": "dpl_counter",
  "metadata": {
    "spec": "0.1.0",
    "description": "A simple counter contract demonstrating DPL basics",
    "repository": "https://github.com/dchat/dchat"
  },
  "instructions": [
    {
      "name": "initialize",
      "discriminator": [0],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false,
          "pda": {
            "seeds": [
              { "kind": "const", "value": "counter" },
              { "kind": "account", "path": "authority" }
            ]
          }
        },
        {
          "name": "authority",
          "isMut": false,
          "isSigner": true
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "initialValue",
          "type": "u64"
        }
      ]
    },
    {
      "name": "increment",
      "discriminator": [1],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false
        }
      ],
      "args": []
    },
    {
      "name": "decrement",
      "discriminator": [2],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false
        }
      ],
      "args": []
    },
    {
      "name": "set",
      "discriminator": [3],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "authority",
          "isMut": false,
          "isSigner": true
        }
      ],
      "args": [
        {
          "name": "newValue",
          "type": "u64"
        }
      ]
    },
    {
      "name": "reset",
      "discriminator": [4],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "authority",
          "isMut": false,
          "isSigner": true
        }
      ],
      "args": []
    },
    {
      "name": "transferAuthority",
      "discriminator": [5],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "authority",
          "isMut": false,
          "isSigner": true
        }
      ],
      "args": [
        {
          "name": "newAuthority",
          "type": "publicKey"
        }
      ]
    }
  ],
  "accounts": [
    {
      "name": "Counter",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "value", "type": "u64" },
          { "name": "authority", "type": "publicKey" },
          { "name": "bump", "type": "u8" },
          { "name": "totalOperations", "type": "u64" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "CounterInitialized",
      "fields": [
        { "name": "counter", "type": "publicKey", "index": true },
        { "name": "authority", "type": "publicKey", "index": true },
        { "name": "initialValue", "type": "u64", "index": false }
      ]
    },
    {
      "name": "CounterChanged",
      "fields": [
        { "name": "counter", "type": "publicKey", "index": true },
        { "name": "oldValue", "type": "u64", "index": false },
        { "name": "newValue", "type": "u64", "index": false },
        {
          "name": "operation",
          "type": { "defined": "OperationType" },
          "index": false
        }
      ]
    },
    {
      "name": "CounterReset",
      "fields": [
        { "name": "counter", "type": "publicKey", "index": true },
        { "name": "authority", "type": "publicKey", "index": true },
        { "name": "oldValue", "type": "u64", "index": false }
      ]
    },
    {
      "name": "AuthorityTransferred",
      "fields": [
        { "name": "counter", "type": "publicKey", "index": true },
        { "name": "oldAuthority", "type": "publicKey", "index": true },
        { "name": "newAuthority", "type": "publicKey", "index": true }
      ]
    }
  ],
  "errors": [
    {
      "code": 6000,
      "name": "Overflow",
      "msg": "Counter overflow: value would exceed maximum"
    },
    {
      "code": 6001,
      "name": "Underflow",
      "msg": "Counter underflow: value cannot go below zero"
    },
    {
      "code": 6002,
      "name": "Unauthorized",
      "msg": "Unauthorized: only the authority can perform this operation"
    }
  ],
  "types": [
    {
      "name": "OperationType",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Increment" },
          { "name": "Decrement" },
          { "name": "Set" }
        ]
      }
    }
  ]
}
