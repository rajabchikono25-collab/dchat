---
import site from '../content/site.json';

const { footer } = site;
---

<footer class="py-12 border-t border-slate-800">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo and tagline -->
      <div class="text-center md:text-left">
        <a href="/" class="text-xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
          {footer.logo}
        </a>
        <p class="text-slate-500 text-sm mt-1">{footer.tagline}</p>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap justify-center gap-6">
        {footer.links.map((link) => (
          <a 
            href={link.href}
            class="text-slate-400 hover:text-white transition-colors text-sm"
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Copyright -->
      <p class="text-slate-600 text-sm">{footer.copyright}</p>
    </div>
  </div>
</footer>
