# DChat Landing Page Environment Configuration
# Copy this file to .env.local and configure as needed

# API Base URL - Main dchat node API endpoint
# Default: http://localhost:9000 for local development
NEXT_PUBLIC_API_URL=http://localhost:9000

# WebSocket URL - For real-time block/transaction updates
# Default: ws://localhost:9001 for local development
NEXT_PUBLIC_WS_URL=ws://localhost:9001

# Metrics URL - Prometheus metrics endpoint
# Default: http://localhost:9090 for local development
NEXT_PUBLIC_METRICS_URL=http://localhost:9090

# Production URLs (uncomment for production deployment)
# NEXT_PUBLIC_API_URL=https://api.testnet.dchat.network
# NEXT_PUBLIC_WS_URL=wss://ws.testnet.dchat.network
# NEXT_PUBLIC_METRICS_URL=https://metrics.testnet.dchat.network
